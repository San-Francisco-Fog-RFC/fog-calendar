<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{{ page.title }} | San Francisco Fog Rugby Football Club</title>
  <meta name="description" content="{{ page.metaDescription }}">
  <link rel="icon" type="image/png" href="https://events.fogrugby.com/assets/img/fog-crest-white.png">

  <!-- First-Party GA4 & Meta Pixel Tracking -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GD8T0M6RZ9"></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-WTRRT4XDS5"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-GD8T0M6RZ9', { page_title: '{{ page.title }}' });
    gtag('config', 'G-WTRRT4XDS5', { page_title: '{{ page.title }}', send_page_view: true });
  </script>

  <style>
    :root {
      --fog-blue: #006EB6;
      --fog-light-blue: #24A0F1;
      --fog-dark-blue: #00243C;
      --fog-gray: #DCDDDE;
      --fog-gray-50: #F8FAFC;
      --fog-dark-gray: #0F172A;
      --fog-white: #FFFFFF;
      --fog-radius-btn: 2px;
      --fog-radius-card: 4px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      font-family: 'Futura PT', -apple-system, BlinkMacSystemFont, Arial, sans-serif;
      background-color: var(--fog-gray-50);
      color: var(--fog-dark-gray);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    .pride-stripe-top {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      width: 100vw;
      height: 5px;
      display: flex;
      z-index: 9999;
    }
    .pride-bar { flex: 1; height: 100%; }

    .split-container {
      display: flex;
      min-height: 100vh;
      width: 100%;
      padding-top: 5px;
    }

    .hero-col {
      width: 44%;
      min-height: calc(100vh - 5px);
      background: linear-gradient(180deg, rgba(0, 36, 60, 0.82) 0%, rgba(0, 18, 30, 0.95) 100%),
                  url('https://events.fogrugby.com/assets/img/calling-ceremony-circle.jpg') center/cover no-repeat;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 40px 44px 36px 44px;
      color: #FFFFFF;
      position: relative;
    }

    .hero-top-section {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .hero-top-nav {
      display: flex;
      justify-content: flex-start;
      align-items: center;
    }
    .back-link {
      color: var(--fog-light-blue);
      text-decoration: underline;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.02em;
      transition: color 0.15s ease;
    }
    .back-link:hover {
      color: #FFFFFF;
    }

    .hero-brand-lockup {
      display: flex;
      align-items: center;
      gap: 18px;
      max-width: 520px;
    }
    .hero-crest {
      width: 80px;
      height: 80px;
      object-fit: contain;
      flex-shrink: 0;
      filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.55));
    }
    .hero-brand-text {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .hero-title {
      font-size: 23px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: #FFFFFF;
      margin: 0;
    }
    .hero-title span {
      display: block;
    }
    .hero-subline {
      font-size: 13px;
      line-height: 1.3;
      color: var(--fog-light-blue);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 700;
      margin-top: 5px;
    }

    .desktop-footer {
      border-top: 1px solid rgba(255, 255, 255, 0.18);
      padding-top: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .footer-links {
      font-size: 13px;
      font-weight: 700;
      color: var(--fog-light-blue);
      line-height: 1.5;
    }
    .footer-links a {
      color: var(--fog-light-blue);
      text-decoration: none;
      transition: color 0.15s ease, text-decoration 0.15s ease;
    }
    .footer-links a:hover {
      color: #FFFFFF;
      text-decoration: underline;
    }
    .footer-links .sep {
      color: rgba(255, 255, 255, 0.4);
      padding: 0 6px;
    }
    .footer-sponsor {
      font-size: 12px;
      line-height: 1.55;
      color: rgba(255, 255, 255, 0.88);
    }
    .footer-copyright {
      font-size: 12px;
      line-height: 1.5;
      color: rgba(255, 255, 255, 0.72);
    }

    .form-col {
      width: 56%;
      min-height: calc(100vh - 5px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 40px 48px;
      background-color: var(--fog-gray-50);
      overflow-y: auto;
    }
    .form-card {
      width: 100%;
      max-width: 580px;
      background-color: #FFFFFF;
      border: 1px solid #D0D7DE;
      box-shadow: 0 8px 30px rgba(0, 36, 60, 0.09);
      border-radius: var(--fog-radius-card);
      padding: 40px 44px 36px 44px;
    }
    
    .mobile-footer {
      display: none;
    }

    @media (max-width: 899px) {
      .split-container {
        flex-direction: column;
        min-height: auto;
      }
      .hero-col {
        width: 100%;
        min-height: auto;
        padding: 26px 20px 24px 20px;
        background: linear-gradient(180deg, rgba(0, 36, 60, 0.88) 0%, rgba(0, 18, 30, 0.96) 100%),
                    url('https://events.fogrugby.com/assets/img/calling-ceremony-circle.jpg') center/cover no-repeat;
      }
      .hero-top-section {
        gap: 14px;
      }
      .hero-brand-lockup {
        gap: 15px;
      }
      .hero-crest {
        width: 60px;
        height: 60px;
      }
      .hero-title {
        font-size: 15.5px;
        line-height: 1.2;
      }

      .hero-subline {
        font-size: 11.5px;
        margin-top: 3px;
      }
      .desktop-footer {
        display: none;
      }
      .form-col {
        width: 100%;
        min-height: auto;
        padding: 24px 16px 32px 16px;
      }
      .form-card {
        padding: 28px 20px;
        box-shadow: none;
        border: 1px solid #E2E8F0;
      }
      .mobile-footer {
        display: block;
        background-color: var(--fog-dark-blue);
        color: #FFFFFF;
        padding: 32px 20px 44px 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        text-align: center;
      }
      .mobile-footer .footer-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 8px 14px;
        font-size: 13.5px;
        margin-bottom: 16px;
        line-height: 1.5;
      }
      .mobile-footer .sep {
        display: none;
      }
      .mobile-footer .footer-sponsor {
        font-size: 12px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.88);
        max-width: 480px;
        margin: 0 auto 8px auto;
      }
      .mobile-footer .footer-copyright {
        font-size: 12px;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.72);
        margin-bottom: 16px;
      }
      .mobile-footer .back-link {
        display: inline-block;
        font-size: 13px;
      }
    }
  </style>
</head>
<body>
  <div class="pride-stripe-top" aria-hidden="true">
    <span class="pride-bar" style="background:#000000"></span><span class="pride-bar" style="background:#613915"></span><span class="pride-bar" style="background:#74D7EE"></span><span class="pride-bar" style="background:#FFAFC8"></span><span class="pride-bar" style="background:#FFFFFF"></span><span class="pride-bar" style="background:#E40303"></span><span class="pride-bar" style="background:#FF8C00"></span><span class="pride-bar" style="background:#FFED00"></span><span class="pride-bar" style="background:#008026"></span><span class="pride-bar" style="background:#004DFF"></span><span class="pride-bar" style="background:#750787"></span>
  </div>

  <div class="split-container">
    <div class="hero-col">
      <div class="hero-top-section">
        <div class="hero-top-nav">
          <a href="https://events.fogrugby.com/the-foghorn-2026-10-29.html" class="back-link">&larr; Back to The Foghorn</a>
        </div>
        <div class="hero-brand-lockup">
          <img src="https://events.fogrugby.com/assets/img/fog-shield.png" alt="SF Fog RFC Crest" class="hero-crest">
          <div class="hero-brand-text">
            <h1 class="hero-title">{{ page.title }}</h1>
            <div class="hero-subline">Inclusive Rugby since 2000</div>
          </div>
        </div>
      </div>
      <div class="desktop-footer">
        <div class="footer-links">
          <a href="https://www.fogrugby.com/" target="_blank">Website</a><span class="sep">&middot;</span>
          <a href="https://instagram.com/sffog" target="_blank">Instagram</a><span class="sep">&middot;</span>
          <a href="https://facebook.com/sffog" target="_blank">Facebook</a><span class="sep">&middot;</span>
          <a href="https://events.fogrugby.com/" target="_blank">Events &amp; Calendar</a><span class="sep">&middot;</span>
          <a href="https://www.fogrugby.com/donate-to-the-team" target="_blank">Donate</a>
        </div>
        <div class="footer-sponsor">
          The San Francisco Fog Rugby Football Club is a fiscally sponsored project of Dancers' Group, a 501(c)(3) non-profit organization.
        </div>
        <div class="footer-copyright">
          &copy; 2000&ndash;2026 San Francisco Fog Rugby Football Club
        </div>
      </div>
    </div>

    <main class="form-col" role="main">
      <div class="form-card" data-slot="text">
        {{ page.content|raw }}
      </div>
    </main>
  </div>

  <footer class="mobile-footer" role="contentinfo">
    <div class="footer-links">
      <a href="https://www.fogrugby.com/" target="_blank">Website</a><span class="sep">&middot;</span>
      <a href="https://instagram.com/sffog" target="_blank">Instagram</a><span class="sep">&middot;</span>
      <a href="https://facebook.com/sffog" target="_blank">Facebook</a><span class="sep">&middot;</span>
      <a href="https://events.fogrugby.com/" target="_blank">Events &amp; Calendar</a><span class="sep">&middot;</span>
      <a href="https://www.fogrugby.com/donate-to-the-team" target="_blank">Donate</a>
    </div>
    <div class="footer-sponsor">
      The San Francisco Fog Rugby Football Club is a fiscally sponsored project of Dancers' Group, a 501(c)(3) non-profit organization.
    </div>
    <div class="footer-copyright">
      &copy; 2000&ndash;2026 San Francisco Fog Rugby Football Club
    </div>
    <div>
      <a href="https://events.fogrugby.com/the-foghorn-2026-10-29.html" class="back-link">&larr; Back to The Foghorn</a>
    </div>
  </footer>
</body>
</html>
