<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{{ page.title }} | San Francisco Fog RFC</title>
  <meta name="description" content="{{ page.metaDescription }}">
  <link rel="icon" type="image/png" href="https://events.fogrugby.com/assets/img/fog-crest-white.png">

  <!-- First-Party GA4 & Meta Pixel Tracking -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GD8T0M6RZ9"></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-WTRRT4XDS5"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-GD8T0M6RZ9', { page_title: '{{ page.title }}' });
    gtag('config', 'G-WTRRT4XDS5', { page_title: '{{ page.title }}', send_page_view: true });
  </script>

  <style>
    :root {
      --fog-blue: #006EB6;
      --fog-light-blue: #24A0F1;
      --fog-dark-blue: #00243C;
      --fog-gray: #DCDDDE;
      --fog-gray-50: #F8FAFC;
      --fog-dark-gray: #0F172A;
      --fog-white: #FFFFFF;
      --fog-radius-btn: 2px;
      --fog-radius-card: 4px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      font-family: 'Futura PT', -apple-system, BlinkMacSystemFont, Arial, sans-serif;
      background-color: var(--fog-gray-50);
      color: var(--fog-dark-gray);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    .pride-stripe-top {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      width: 100vw;
      height: 5px;
      display: flex;
      z-index: 9999;
    }
    .pride-bar { flex: 1; height: 100%; }

    .split-container {
      display: flex;
      min-height: 100vh;
      width: 100%;
      padding-top: 5px;
    }

    .hero-col {
      width: 44%;
      min-height: calc(100vh - 5px);
      background: linear-gradient(180deg, rgba(0, 36, 60, 0.78) 0%, rgba(0, 18, 30, 0.94) 100%),
                  url('https://events.fogrugby.com/assets/img/calling-ceremony-circle.jpg') center/cover no-repeat;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 48px 44px 36px 44px;
      color: #FFFFFF;
      position: relative;
    }

    .hero-top-spacer { height: 20px; }

    .hero-centerpiece {
      margin: auto 0;
      text-align: left;
      max-width: 460px;
    }
    .hero-crest-lg {
      width: 110px;
      height: 110px;
      object-fit: contain;
      filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.5));
      margin-bottom: 22px;
      display: block;
    }
    .hero-title-lg {
      font-size: 38px;
      line-height: 1.1;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #FFFFFF;
      margin-bottom: 8px;
    }
    .hero-subline-lg {
      font-size: 16px;
      line-height: 1.3;
      color: var(--fog-light-blue);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 700;
    }

    .hero-footer {
      font-size: 12px;
      line-height: 1.5;
      color: rgba(255, 255, 255, 0.75);
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      padding-top: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .hero-footer-legal {
      color: rgba(255, 255, 255, 0.85);
    }
    .hero-footer a {
      color: var(--fog-light-blue);
      text-decoration: underline;
      font-weight: 700;
      align-self: flex-start;
    }

    .form-col {
      width: 56%;
      min-height: calc(100vh - 5px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 40px 48px;
      background-color: var(--fog-gray-50);
      overflow-y: auto;
    }
    .form-card {
      width: 100%;
      max-width: 580px;
      background-color: #FFFFFF;
      border: 1px solid #D0D7DE;
      box-shadow: 0 8px 30px rgba(0, 36, 60, 0.09);
      border-radius: var(--fog-radius-card);
      padding: 40px 44px 36px 44px;
    }
    
    @media (max-width: 899px) {
      .split-container { flex-direction: column; min-height: auto; }
      .hero-col { width: 100%; min-height: auto; padding: 36px 24px 28px 24px; }
      .hero-crest-lg { width: 80px; height: 80px; margin-bottom: 16px; }
      .hero-title-lg { font-size: 28px; }
      .hero-subline-lg { font-size: 14px; }
      .form-col { width: 100%; min-height: auto; padding: 28px 16px 40px 16px; }
      .form-card { padding: 28px 20px; box-shadow: none; border: 1px solid #E2E8F0; }
    }
  </style>
</head>
<body>
  <div class="pride-stripe-top" aria-hidden="true">
    <span class="pride-bar" style="background:#000000"></span><span class="pride-bar" style="background:#613915"></span><span class="pride-bar" style="background:#74D7EE"></span><span class="pride-bar" style="background:#FFAFC8"></span><span class="pride-bar" style="background:#FFFFFF"></span><span class="pride-bar" style="background:#E40303"></span><span class="pride-bar" style="background:#FF8C00"></span><span class="pride-bar" style="background:#FFED00"></span><span class="pride-bar" style="background:#008026"></span><span class="pride-bar" style="background:#004DFF"></span><span class="pride-bar" style="background:#750787"></span>
  </div>

  <div class="split-container">
    <div class="hero-col">
      <div class="hero-top-spacer"></div>
      <div class="hero-centerpiece">
        <img src="https://events.fogrugby.com/assets/img/fog-shield.png" alt="SF Fog RFC Crest" class="hero-crest-lg">
        <h1 class="hero-title-lg">{{ page.title }}</h1>
        <div class="hero-subline-lg">Inclusive Rugby since 2000</div>
      </div>
      <div class="hero-footer">
        <div class="hero-footer-legal">
          &copy; 2000&ndash;2026 San Francisco Fog Rugby Football Club &middot; A fiscally sponsored project of Dancers' Group
        </div>
        <a href="https://www.fogrugby.com">fogrugby.com &rarr;</a>
      </div>
    </div>

    <main class="form-col" role="main">
      <div class="form-card" data-slot="text">
        {{ page.content|raw }}
      </div>
    </main>
  </div>
</body>
</html>
